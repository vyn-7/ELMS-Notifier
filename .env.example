# Copy this file to .env and fill in the real bot token and channel ID.
# .env is gitignored. Never commit the real values.
DISCORD_BOT_TOKEN=REPLACE_WITH_BOT_TOKEN
DISCORD_CHANNEL_ID=REPLACE_WITH_CHANNEL_ID

# Optional CI/headless cookie jar. Local interactive runs use .session/storage-state.json.
# ELMS_COOKIES_JSON=
